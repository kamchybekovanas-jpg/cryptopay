[Unit]
Description=CryptoPay payment service
After=bitcoind.service
Requires=bitcoind.service

[Service]
User=cryptopay
Group=cryptopay
WorkingDirectory=/opt/cryptopay
EnvironmentFile=/opt/cryptopay/.env
StateDirectory=cryptopay
ExecStart=/opt/cryptopay/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
# если узел ещё загружается, сервис упадёт на старте и перезапустится
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
